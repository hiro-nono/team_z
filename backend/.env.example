# AES-256-GCM用の鍵(base64エンコードされた32バイト)。GoogleCalendarConnectionのAccessToken/RefreshTokenの暗号化に使用する
TOKEN_ENCRYPTION_KEY=

GOOGLE_OAUTH_REVOKE_URL=

# AI（OrcaRouterが既定）
AI_PROVIDER=orcarouter
AI_BASE_URL=https://api.orcarouter.ai/v1
AI_API_KEY=
AI_MODEL=openai/gpt-4o-mini
AI_DEBUG=false

# Node API
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
MAX_FILE_SIZE_BYTES=10485760

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/auth/callback
GOOGLE_OAUTH_REVOKE_URL=

# PostgreSQL（Calendar連携を有効化する場合）
DATABASE_SSL=true
DATABASE_URL=

Go認証 / Supabase PostgreSQL Backend
GO_PORT=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=

# OrcaRouter（Go Backend: POST /api/analyze のPDF解析で使用）
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_API_KEY=
ORCAROUTER_MODEL=openai/gpt-4o-mini